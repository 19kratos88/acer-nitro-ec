#!/usr/bin/env bash
set -euo pipefail

# systemd authorizes the start through PolicyKit manage-units rules.
if ! /usr/bin/systemctl --system start nitro-fan-gaming.service; then
    message='Could not start nitro-fan-gaming.service. Check authorization and the service journal.'
    printf 'nitro-fan: %s\n' "$message" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$message" || true
    fi
    exit 1
fi
