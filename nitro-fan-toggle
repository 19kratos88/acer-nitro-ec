#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'nitro-fan-toggle: %s\n' "$*" >&2
    exit 1
}

# KDE runs this helper as the desktop user, who cannot create files in /run.
readonly lock_dir=/run/user/$UID
[[ -d "$lock_dir" && -O "$lock_dir" && -w "$lock_dir" ]] || \
    die "User runtime directory unavailable: $lock_dir."
command -v flock >/dev/null 2>&1 || die 'flock is required.'
exec {lock_fd}>"$lock_dir/nitro-fan-toggle.lock" || die 'Cannot open toggle lock.'
if flock -n -E 75 "$lock_fd"; then
    :
else
    lock_status=$?
    if (( lock_status == 75 )); then
        printf 'nitro-fan-toggle: Another toggle is in progress.\n' >&2
        exit 0
    fi
    die 'Cannot acquire toggle lock.'
fi

# /proc/uptime is elapsed time since boot, unaffected by wall-clock changes.
# Its centisecond precision is sufficient for this short cooldown.
uptime_ms() {
    local uptime idle
    read -r uptime idle < /proc/uptime || die 'Cannot read uptime.'
    [[ "$uptime" =~ ^([0-9]{1,12})\.([0-9]{2})$ ]] || die 'Invalid uptime.'
    printf '%s\n' "$((10#${BASH_REMATCH[1]} * 1000 + 10#${BASH_REMATCH[2]} * 10))"
}

readonly debounce_file="$lock_dir/nitro-fan-toggle.last-success"
now=$(uptime_ms)
if [[ -e "$debounce_file" ]]; then
    IFS= read -r last_success < "$debounce_file" || die 'Cannot read debounce state.'
    [[ "$last_success" =~ ^[0-9]{1,16}$ ]] || die 'Invalid debounce state.'
    elapsed=$((now - 10#$last_success))
    (( elapsed >= 0 )) || die 'Debounce timestamp is ahead of uptime.'
    if (( elapsed < 750 )); then
        printf 'nitro-fan-toggle: Ignoring rapid repeat toggle.\n' >&2
        exit 0
    fi
fi

# Exit 3 means not active, including failed/transitional states. Check the
# returned state too; only an explicit inactive result may start gaming.
query_status=0
state=$(/usr/bin/systemctl --system is-active nitro-fan-gaming.service) || query_status=$?
case "$query_status:$state" in
    0:active) helper=/usr/local/bin/nitro-fan-auto ;;
    3:inactive) helper=/usr/local/bin/nitro-fan-gaming-start ;;
    *) die "Cannot toggle: service query returned status $query_status, state '${state:-empty}'." ;;
esac

# Keep the lock in this waiting parent, not in helpers or notification children.
# Never unlink the lock file: other invocations must lock the same inode.
(
    exec {lock_fd}>&-
    exec "$helper"
)

# With errexit, query/helper failures never reach this update. Keep the lock
# until the successful helper completion time has been recorded.
now=$(uptime_ms)
printf '%s\n' "$now" > "$debounce_file" || die 'Cannot save debounce state.'
